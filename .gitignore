# Node 依赖与日志
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android 本地编译产物与 SDK 路径 (避免泄露个人电脑绝对路径)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.cxx/

# 二进制安装包 (请通过 GitHub Releases 发布，勿直接 commit 进 Git 树)
*.apk
*.aab

# 密钥证书 (严禁上传)
*.jks
*.keystore
*.key

# 编辑器与系统配置
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 临时测试与缓存文件
*.log
tmp/
temp/
